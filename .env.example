# Copy to .env and fill in. NEVER commit .env.
# ---- database ----
SR_DATABASE_URL=postgresql+psycopg://secondreader:secondreader@localhost:5432/secondreader
# ---- secrets (generate with: python -c "import secrets;print(secrets.token_hex(32))") ----
SR_PSEUDONYM_SECRET=change-me-64-hex-chars
SR_BLOB_ENCRYPTION_KEY=change-me-64-hex-chars
SR_AUTH_SECRET=change-me-64-hex-chars
# ---- storage ----
SR_BLOB_ROOT=./data/blobs
# ---- orthanc ----
SR_ORTHANC_A_URL=http://localhost:8042
SR_ORTHANC_A_USER=orthanc
SR_ORTHANC_A_PASSWORD=orthanc
SR_ORTHANC_B_URL=http://localhost:8043
SR_ORTHANC_B_USER=orthanc
SR_ORTHANC_B_PASSWORD=orthanc
# ---- serving ----
SR_MODEL_REGISTRY_ROOT=./models
SR_ACTIVE_MODEL_ID=
